{
  "name": "@h2-fe/web-ui",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@h2-fe/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "tags": [
      "scope:web",
      "type:ui"
    ],
    "targets": {
      "lint": {
        "options": {
          "args": [
            "--type-aware"
          ]
        }
      },
      "lint:fix": {
        "command": "oxlint . --type-aware --fix",
        "options": {
          "cwd": "libs/web/ui"
        }
      },
      "format": {},
      "format:fix": {},
      "test-storybook": {
        "inputs": [
          "default",
          "^production",
          "storybookTestRunner",
          "{workspaceRoot}/libs/web/features/*/src/**/*",
          "{workspaceRoot}/apps/web/src/app/routes/home/**/*"
        ]
      },
      "build-storybook": {
        "inputs": [
          "production",
          "{projectRoot}/**/*.stories.@(js|jsx|ts|tsx|mdx)",
          "{projectRoot}/.storybook/**/*",
          "{projectRoot}/tsconfig.storybook.json",
          "{workspaceRoot}/libs/web/features/*/src/**/*",
          "!{workspaceRoot}/libs/web/features/*/src/**/*.spec.@(ts|tsx)",
          "{workspaceRoot}/apps/web/src/app/routes/home/**/*",
          "!{workspaceRoot}/apps/web/src/app/routes/home/**/*.spec.@(ts|tsx)"
        ]
      }
    }
  }
}
