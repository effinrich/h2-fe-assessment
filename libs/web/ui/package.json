{
  "name": "@h2-fe/web-ui",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@h2-fe/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "storybook-web": "nx run storybook-web",
    "build-storybook-web": "nx run build-storybook-web",
    "lint": "oxlint . --type-aware",
    "lint:fix": "oxlint . --type-aware --fix",
    "format": "oxfmt .",
    "format:fix": "oxfmt . --fix",
    "build": "nx run build"
  },
  "nx": {
    "tags": [
      "scope:web",
      "type:ui"
    ],
    "targets": {
      "storybook-web": {
        "executor": "@nx/storybook:storybook",
        "options": {
          "port": 4400,
          "open": true,
          "configDir": "libs/web/ui/.storybook"
        },
        "configurations": {
          "ci": {
            "quiet": true
          }
        }
      },
      "build-storybook-web": {
        "inputs": [
          "production",
          "{projectRoot}/**/*.stories.@(js|jsx|ts|tsx|mdx)",
          "{projectRoot}/.storybook/**/*",
          "{projectRoot}/tsconfig.storybook.json",
          "{workspaceRoot}/libs/web/features/**/src/lib/**/*.stories.@(js|jsx|ts|tsx)"
        ]
      }
    }
  }
}
