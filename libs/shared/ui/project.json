{
  "name": "shared-ui",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/ui/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:ui"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint . --type-aware",
        "cwd": "{projectRoot}"
      }
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint . --type-aware --fix",
        "cwd": "{projectRoot}"
      }
    },
    "format": {},
    "format:fix": {},
    "test-storybook": {
      "inputs": [
        "default",
        "^production",
        "storybookTestRunner",
        "{workspaceRoot}/libs/web/features/*/src/**/*",
        "{workspaceRoot}/libs/web/ui/src/**/*",
        "{workspaceRoot}/apps/web/src/app/routes/home/**/*"
      ]
    },
    "storybook": {
      "options": {
        "port": 4400,
        "config-dir": ".storybook"
      },
      "configurations": {
        "ci": {
          "args": ["--quiet"]
        }
      }
    },
    "build-storybook": {
      "outputs": ["{workspaceRoot}/dist/storybook/shared-ui"],
      "inputs": [
        "production",
        "{projectRoot}/**/*.stories.@(js|jsx|ts|tsx|mdx)",
        "{projectRoot}/.storybook/**/*",
        "{projectRoot}/tsconfig.storybook.json",
        "{workspaceRoot}/libs/web/features/*/src/**/*",
        "!{workspaceRoot}/libs/web/features/*/src/**/*.spec.@(ts|tsx)",
        "{workspaceRoot}/libs/web/ui/src/**/*",
        "!{workspaceRoot}/libs/web/ui/src/**/*.spec.@(ts|tsx)",
        "{workspaceRoot}/apps/web/src/app/routes/home/**/*",
        "!{workspaceRoot}/apps/web/src/app/routes/home/**/*.spec.@(ts|tsx)"
      ],
      "options": {
        "config-dir": ".storybook",
        "output-dir": "../../../dist/storybook/shared-ui",
        "args": ["--stats-json"]
      },
      "configurations": {
        "ci": {
          "args": ["--stats-json", "--quiet"]
        }
      }
    }
  }
}
