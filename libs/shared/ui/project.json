{
  "name": "shared-ui",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/ui/src",
  "projectType": "library",
  "tags": [
    "scope:shared",
    "type:ui"
  ],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "args": ["--type-aware"]
      }
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "args": ["--type-aware", "--fix"]
      }
    },
   "storybook": {
      "configurations": {
        "ci": {
          "quiet": true
        }
      },
      "executor": "@nx/storybook:storybook",
      "options": {
        "port": 4400,
        "open": true,
        "configDir": "libs/shared/ui/.storybook"
      }
    },
    "build-storybook": {
      "executor": "@nx/storybook:build",
      "outputs": ["{options.outputDir}"],
      "options": {
        "framework": "@storybook/react-vite",
        "outputDir": "dist/storybook/shared-ui",
        "configDir": "libs/shared/ui/.storybook",
        "webpackStatsJson": true
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "targets": {
      "chromatic": {
        "metadata": {
          "projectId": "112233445566778899"
        },
        "options": {
          "args": [
            "--project-token=$CHROMATIC_PROJECT_TOKEN"
          ]
        }
      }
    }
  }
}
