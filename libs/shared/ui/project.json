{
  "name": "shared-ui",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/ui/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:ui"],
  "targets": {
    "lint": {
      "options": {
        "args": ["--type-aware"]
      }
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint . --type-aware --fix",
        "cwd": "{projectRoot}"
      }
    },
    "format": {},
    "format:fix": {},
    "storybook": {
      "options": {
        "port": 4400,
        "config-dir": ".storybook"
      },
      "configurations": {
        "ci": {
          "args": ["--quiet"]
        }
      }
    },
    "build-storybook": {
      "outputs": ["{workspaceRoot}/dist/storybook/shared-ui"],
      "inputs": [
        "production",
        "{projectRoot}/**/*.stories.@(js|jsx|ts|tsx|mdx)",
        "{projectRoot}/.storybook/**/*",
        "{projectRoot}/tsconfig.storybook.json"
      ],
      "options": {
        "config-dir": ".storybook",
        "output-dir": "../../../dist/storybook/shared-ui",
        "args": ["--stats-json"]
      },
      "configurations": {
        "ci": {
          "args": ["--stats-json", "--quiet"]
        }
      }
    }
  }
}
