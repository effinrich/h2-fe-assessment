{
  "name": "@h2-fe/source",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "libs/shared/*",
    "libs/web/features/*",
    "libs/web/**"
  ],
  "scripts": {
    "start": "nx serve @h2-fe/web",
    "build": "nx build @h2-fe/web",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint:fix",
    "format": "nx run-many -t format",
    "format:fix": "nx run-many -t format:fix",
    "storybook": "nx run shared-ui:storybook",
    "build-storybook": "nx run shared-ui:build-storybook",
    "storybook:web": "nx run @h2-fe/web-ui:storybook",
    "build-storybook:web": "nx run @h2-fe/web-ui:build-storybook",
    "storybook-web": "bun run storybook:web",
    "build-storybook-web": "bun run build-storybook:web",
    "gate": "nx affected -t lint,format,typecheck,test,build,build-storybook,test-storybook"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@chromatic-com/storybook": "^5.4.0",
    "@emotion/react": "^11.14.0",
    "@tanstack/react-query": "^5.104.0",
    "lucide-react": "^1.52.0",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "6.30.3",
    "tldraw": "^5.5.0"
  },
  "devDependencies": {
    "@nx/js": "23.2.1",
    "@nx/oxlint": "23.2.1",
    "@nx/react": "23.2.1",
    "@nx/storybook": "23.2.1",
    "@nx/vite": "23.2.1",
    "@nx/vitest": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "20.19.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/browser-playwright": "~4.1.0",
    "@vitest/coverage-v8": "~4.1.0",
    "jsdom": "~22.1.0",
    "nx": "23.2.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2003",
    "playwright": "^1.63.0",
    "storybook": "10.6.1",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "vite": "^8.0.0",
    "vite-plugin-dts": "~4.5.0",
    "vitest": "~4.1.0"
  },
  "allowScripts": {
    "@nx/oxlint": true,
    "@nx/vite": true,
    "@parcel/watcher@2.5.6": true,
    "esbuild": true,
    "nx": true,
    "@swc/core": true,
    "fsevents": true
  },
  "nx": {
    "includedScripts": []
  }
}
