{
  "name": "@h2-fe/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "nx serve web",
    "build": "nx build web",
    "test": "nx run-many -t test",
    "storybook": "nx run shared-ui:storybook",
    "build-storybook": "nx run shared-ui:build-storybook",
    "gate": "nx affected -t lint,typecheck,test,build-storybook"
  },
  "private": true,
  "dependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11.14.0",
    "@tanstack/react-query": "^5.104.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "6.30.3"
  },
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@eslint/js": "^9.8.0",
    "@nx/eslint": "22.7.12",
    "@nx/eslint-plugin": "22.7.12",
    "@nx/js": "22.7.12",
    "@nx/oxlint": "^23.2.1",
    "@nx/react": "22.7.12",
    "@nx/storybook": "^22.7.12",
    "@nx/vite": "22.7.12",
    "@nx/vitest": "22.7.12",
    "@nx/web": "22.7.12",
    "@nx/workspace": "22.7.12",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "20.19.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "~4.1.0",
    "@vitest/ui": "~4.1.0",
    "ajv": "^8.0.0",
    "chromatic": "^18.10.1",
    "eslint": "^9.8.0",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "nx": "22.7.12",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.75.0",
    "storybook": "10.6.1",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "verdaccio": "^6.3.2",
    "vite": "^8.0.0",
    "vite-plugin-dts": "~4.5.0",
    "vitest": "~4.1.0"
  },
  "workspaces": [
    "apps/*",
    "libs/shared/*",
    "libs/web/features/*",
    "libs/web/**"
  ],
  "allowScripts": {
    "@nx/oxlint": true,
    "@nx/vite": true,
    "@parcel/watcher@2.5.6": true,
    "esbuild": true,
    "nx": true,
    "@swc/core": true,
    "fsevents": true
  },
  "nx": {
    "includedScripts": [],
    "targets": {
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      }
    }
  }
}
